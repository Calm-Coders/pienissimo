      "kind": "component",
      "requirements": ["ORD-01", "DM-17"],
      "component": "apex-class:QuoteTrancheController",
      "expect_repo": "present",
      "expect_org": "present"
    },
    {
      "id": "ORD-01-tranche-ui",
      "kind": "component",
      "requirements": ["ORD-01", "DM-17"],
      "component": "lwc:quoteCreateTranche",
      "expect_repo": "present",
      "expect_org": "present"
    },
    {
      "id": "ORD-01-tranche-permission-set",
      "kind": "component",
      "requirements": ["ORD-01", "DM-17"],
      "component": "permission-set:Tranche_Management",
      "expect_repo": "present",
      "expect_org": "present"
    },
    {
      "id": "NFR-06-apex-coverage",
      "kind": "coverage",
      "requirements": ["NFR-06"],
      "minimum_percent": 75,
