{
  "schema_version": 1,
  "description": "Executable structural checks for org-status-check. This maps requirement IDs to evidence targets; it does not replace or restate the requirements register.",
  "assertions": [
    {
      "id": "BUN-03-object",
      "kind": "component",
      "requirements": ["BUN-03"],
      "component": "object:BundleComponent__c",
      "expect_repo": "present",
      "expect_org": "present",
      "notes": [
        "Structural presence only; bundle behaviour still needs source and runtime evidence."
      ]
    },
    {
      "id": "BUN-03-trigger",
      "kind": "component",
      "requirements": ["BUN-03"],
      "component": "apex-trigger:BundleComponentTrigger",
      "expect_repo": "present",
      "expect_org": "present"
    },
    {
      "id": "ORD-01-tranche-object",
      "kind": "component",
      "requirements": ["ORD-01", "DM-17"],
      "component": "object:Tranche__c",
      "expect_repo": "present",
      "expect_org": "present"
    },
    {
      "id": "ORD-01-quote-line-tranche",
      "kind": "component",
      "requirements": ["ORD-01", "DM-17"],
      "component": "field:QuoteLineItem.Tranche__c",
      "expect_repo": "present",
      "expect_org": "present",
      "permission": "edit"
    },
    {
      "id": "ORD-01-order-item-tranche",
      "kind": "component",
      "requirements": ["ORD-01", "DM-17"],
      "component": "field:OrderItem.Tranche__c",
      "expect_repo": "present",
