{
  "name": "salesforce-app",
  "private": true,
  "version": "1.0.0",
  "description": "Salesforce App",
  "scripts": {
    "lint": "eslint **/{aura,lwc}/**/*.js",
    "test": "npm run test:unit",
    "test:unit": "sfdx-lwc-jest",
    "test:unit:watch": "sfdx-lwc-jest --watch",
    "test:unit:debug": "sfdx-lwc-jest --debug",
    "test:unit:coverage": "sfdx-lwc-jest --coverage",
    "intelligence:graph": "python -X utf8 -m graphify.salesforce extract force-app --output-dir graphify-out",
    "intelligence:index": "open-codebase-index-mcp index --project . --host codex --config .codebase-index/config.json --verbose",
    "intelligence:index:dry-run": "open-codebase-index-mcp index --project . --host codex --config .codebase-index/config.json --dry-run --verbose",
    "intelligence:refresh": "npm run intelligence:graph && npm run intelligence:index",
    "intelligence:setup": "node scripts/setup-code-intelligence.mjs",
    "intelligence:setup:check": "node scripts/setup-code-intelligence.mjs --check",
    "intelligence:status": "cbi status --project . --host codex",
    "intelligence:view": "node scripts/graph-view.mjs",
    "intelligence:verify": "node scripts/run-with-git-sh.mjs scripts/verify-graph-refresh.sh",
    "org-status:snapshot:repo": "node .agents/skills/org-status-check/scripts/repo-snapshot.mjs",
    "org-status:snapshot:org": "node .agents/skills/org-status-check/scripts/org-snapshot.mjs",
    "org-status:compare": "node .agents/skills/org-status-check/scripts/compare.mjs",
    "org-status:validate": "node .agents/skills/org-status-check/scripts/validate.mjs",
    "org-status:validate:strict": "node .agents/skills/org-status-check/scripts/validate.mjs --strict-build-state",
    "org-status:test": "node --test .agents/skills/org-status-check/scripts/org-status.test.mjs",
    "retrieve": "sf project retrieve start",
    "postretrieve": "npm run intelligence:graph",
    "prettier": "prettier --write \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "prettier:verify": "prettier --check \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "prepare": "husky || true",
    "precommit": "lint-staged",
    "vault:check": "node scripts/vault-check.mjs"
  },
  "devDependencies": {
    "@lwc/eslint-plugin-lwc": "^3.1.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@salesforce/eslint-config-lwc": "^4.0.0",
    "@salesforce/eslint-plugin-aura": "^3.0.0",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.0.2",
    "eslint": "^9.29.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "open-codebase-index": "^0.25.1",
    "prettier": "^3.5.3",
    "prettier-plugin-apex": "^2.2.6"
  },
  "lint-staged": {
    "**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}": [
      "prettier --write"
    ],
    "**/{aura,lwc}/**/*.js": [
      "eslint"
    ],
    "**/lwc/**": [
      "sfdx-lwc-jest -- --bail --findRelatedTests --passWithNoTests"
    ]
  }
}
