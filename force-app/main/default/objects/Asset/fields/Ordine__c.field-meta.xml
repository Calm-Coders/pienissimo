<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Ordine__c</fullName>
    <description
  >Link to the originating Order, displaying its Order Number.</description>
    <externalId>false</externalId>
    <formula
  >IF(ISBLANK(Order_Product__r.OrderId), "", HYPERLINK("/" &amp; CASESAFEID(Order_Product__r.OrderId), Order_Product__r.Order.OrderNumber, "_self"))</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>Ordine</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
