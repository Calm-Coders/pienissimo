<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Agente_required_for_Azienda_and_Locale</fullName>
    <active>true</active>
    <description
  >Requires an Agente for both Azienda and Locale accounts.</description>
    <errorConditionFormula>AND(
$RecordType.DeveloperName = "Azienda"
  ,
  ISBLANK(Agente__c)
)</errorConditionFormula>
    <errorDisplayField>Agente__c</errorDisplayField>
    <errorMessage>Agente è obbligatorio.</errorMessage>
</ValidationRule>
