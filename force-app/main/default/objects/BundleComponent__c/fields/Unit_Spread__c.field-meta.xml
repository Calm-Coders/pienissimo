<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Unit_Spread__c</fullName>
    <description
  >Spread_Price__c divided by Quantity__c — the revenue attributed to a single unit of this product inside this bundle.</description>
    <formula>IF(Quantity__c = 0, 0, Spread_Price__c / Quantity__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Unit Spread</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
