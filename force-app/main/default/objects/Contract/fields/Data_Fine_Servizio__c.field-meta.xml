<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Data_Fine_Servizio__c</fullName>
    <description
  >Fine dei 12 mesi di servizio, calcolata dalla data di attivazione.</description>
    <formula
  >IF(ISBLANK(Data_Attivazione__c), NULL, ADDMONTHS(Data_Attivazione__c, 12) - 1)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Data Fine Servizio</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Date</type>
</CustomField>
