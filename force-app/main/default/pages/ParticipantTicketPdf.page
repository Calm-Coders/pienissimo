<apex:page
  controller="ParticipantTicketPdfController"
  renderAs="pdf"
  showHeader="false"
  sidebar="false"
  standardStylesheets="false"
  readOnly="true"
  cache="false"
  language="it"
  applyHtmlTag="false"
  applyBodyTag="false"
>
  <html>
    <head>
      <style type="text/css">
        @page {
          size: A4;
          margin: 0;
        }
        html,
        body {
          margin: 0;
          padding: 0;
        }
        body {
          color: #111;
          font-family: Arial, Helvetica, sans-serif;
        }
        .sheet {
          height: 841pt;
          overflow: hidden;
          page-break-after: always;
          position: relative;
          width: 595pt;
        }
        .sheet.last {
          page-break-after: auto;
        }
        .txt,
        .dynamic,
        .rule,
        .rect,
        .brand {
          position: absolute;
        }
        .txt {
          line-height: 1.16;
          white-space: nowrap;
        }
        .dynamic {
          background: #fff;
          font-family: Arial, Helvetica, sans-serif;
          font-size: 6.5pt;
          line-height: 1.15;
          min-height: 9pt;
          overflow: hidden;
          white-space: nowrap;
        }
        .dynamic.right-value {
          font-size: 8pt;
          text-align: center;
        }
        .dynamic.wrap {
          line-height: 1.2;
          white-space: normal;
        }
        .rule,
        .rect {
          display: block;
          font-size: 0;
        }
        .brand {
          position: absolute;
          text-align: left;
        }
        .brand-icon {
          background: #e51f2b;
          color: #fff;
          display: inline-block;
          font-size: 11pt;
          font-weight: bold;
          height: 22pt;
          line-height: 22pt;
          margin-right: 5pt;
          text-align: center;
          vertical-align: middle;
          width: 22pt;
        }
        .brand-name {
          font-size: 24pt;
          font-weight: bold;
          vertical-align: middle;
        }
        .brand-rule {
          border-top: 3pt solid #e51f2b;
          display: block;
          margin-top: 2pt;
        }
        .brand-tagline {
          display: block;
          font-size: 5.5pt;
          font-weight: bold;
          letter-spacing: 1.2pt;
          padding-top: 3pt;
          text-align: center;
        }
        .qr {
          border-collapse: collapse;
          left: 108pt;
          position: absolute;
          top: 236pt;
        }
        .qr td {
          height: 3pt;
          line-height: 3pt;
          margin: 0;
          padding: 0;
          width: 3pt;
        }
        .qr-dark {
          background: #000;
        }
        .qr-light {
          background: #fff;
        }

        /* ===== Corrected ticket page styles ===== */
        .ticket-sheet {
          position: relative;
          width: 595pt;
          height: 841pt;
          overflow: hidden;
          page-break-after: always;
        }
        .ticket-vline {
          position: absolute;
          left: 297.5pt;
          top: 12pt;
          height: 681pt;
          border-left: 0.6pt dashed #777;
        }
        .ticket-hline {
          position: absolute;
          left: 12pt;
          top: 397pt;
          width: 571pt;
          border-top: 0.6pt dashed #777;
        }
        .ticket-label {
          position: absolute;
          font-family: Arial, Helvetica, sans-serif;
          color: #111;
        }
        .ticket-label .h {
          font-size: 10pt;
          font-weight: bold;
          line-height: 1.1;
        }
        .ticket-label .v {
          margin-top: 2pt;
          font-size: 6.4pt;
          line-height: 1.2;
          white-space: normal;
        }
        .ticket-logo {
          position: absolute;
          left: 323pt;
          top: 80pt;
          width: 226pt;
          height: auto;
        }
        .ticket-event-center {
          position: absolute;
          left: 321pt;
          top: 202pt;
          width: 230pt;
          text-align: center;
          font-family: Arial, Helvetica, sans-serif;
          color: #555;
        }
        .ticket-event-center .name {
          font-size: 8.5pt;
          line-height: 1.2;
        }
        .ticket-event-center .date {
          margin-top: 38pt;
          font-size: 8pt;
        }
        .ticket-event-center .location {
          margin-top: 19pt;
          font-size: 7.2pt;
          line-height: 1.25;
          white-space: normal;
        }
        .ticket-qr {
          border-collapse: collapse;
          position: absolute;
          left: 95pt;
          top: 224pt;
        }
        .ticket-qr td {
          width: 3.6pt;
          height: 3.6pt;
          line-height: 3.6pt;
          padding: 0;
          margin: 0;
        }
        .ticket-bottom-title {
          position: absolute;
          top: 422pt;
          font-family: Arial, Helvetica, sans-serif;
          font-size: 9pt;
          font-weight: bold;
        }
        .ticket-info-box {
          position: absolute;
          border: 0.6pt solid #999;
          font-family: Arial, Helvetica, sans-serif;
          color: #111;
          box-sizing: border-box;
        }
        .ticket-additional {
          left: 29pt;
          top: 447pt;
          width: 240pt;
          height: 175pt;
          padding: 10pt 9pt;
          font-size: 8.4pt;
          line-height: 1.22;
        }
        .ticket-organizer {
          left: 315pt;
          top: 447pt;
          width: 236pt;
          height: 257pt;
          padding: 8pt 8pt;
          font-size: 8.1pt;
          line-height: 1.18;
        }
        .ticket-organizer p {
          margin: 0 0 4pt 0;
        }
        .ticket-organizer ul {
          margin: 4pt 0 5pt 13pt;
          padding: 0;
        }
        .ticket-organizer li {
          margin: 0 0 2pt 0;
        }
        .ticket-organizer-table {
          width: 100%;
          border-collapse: collapse;
          margin-top: 6pt;
        }
        .ticket-organizer-table td {
          vertical-align: top;
          padding: 1.5pt 0;
          font-size: 7.4pt;
          line-height: 1.18;
        }
        .ticket-organizer-table .k {
          width: 79pt;
          font-weight: bold;
          padding-right: 4pt;
        }
        .ticket-organizer-table .v {
          white-space: normal;
          word-wrap: break-word;
        }
        .page-logo {
          position: absolute;
          height: auto;
        }
      </style>
    </head>
    <body>
      <div class="ticket-sheet">
        <span class="ticket-vline"></span>
        <span class="ticket-hline"></span>

        <div class="ticket-label" style="left: 28pt; top: 24pt; width: 190pt">
          <div class="h">EVENTO</div>
          <div class="v"><apex:outputText value="{!eventName}" /></div>
          <div class="v"><apex:outputText value="{!eventDate}" /></div>
        </div>

        <div class="ticket-label" style="left: 28pt; top: 73pt; width: 190pt">
          <div class="h">PARTECIPANTE</div>
          <div class="v"><apex:outputText value="{!participantName}" /></div>
          <div class="v"><apex:outputText value="{!participantEmail}" /></div>
          <div class="v"><apex:outputText value="{!accountName}" /></div>
        </div>

        <div class="ticket-label" style="left: 28pt; top: 132pt; width: 190pt">
          <div class="h">TICKET</div>
          <div class="v"><apex:outputText value="{!ticketName}" /></div>
        </div>

        <apex:image
          value="{!URLFOR($Resource.QuotePdfLogo)}"
          styleClass="ticket-logo"
        />

        <div class="ticket-event-center">
          <div class="name"><apex:outputText value="{!eventName}" /></div>
          <div class="date"><apex:outputText value="{!eventDate}" /></div>
          <div class="location">
            <apex:outputText value="{!eventLocationLine}" />
          </div>
        </div>

        <apex:outputPanel rendered="{!hasQrCode}" layout="none">
          <table class="ticket-qr">
            <apex:repeat value="{!qrRows}" var="qrRow">
              <tr>
                <apex:repeat value="{!qrRow.modules}" var="module">
                  <td class="{!IF(module, 'qr-dark', 'qr-light')}"></td>
                </apex:repeat>
              </tr>
            </apex:repeat>
          </table>
        </apex:outputPanel>

        <div class="ticket-bottom-title" style="left: 29pt">
          INFORMAZIONI AGGIUNTIVE
        </div>
        <div class="ticket-info-box ticket-additional">
          <div>Diamond e Vip hanno ingresso dedicato.</div>
          <div style="margin-top: 9pt">
            Grazie per aver scelto di partecipare agli eventi di Pienissimo.
          </div>
          <div style="margin-top: 9pt">
            In caso di difficoltà o imprevisti che ti impediscono di partecipare
            all'evento puoi sempre far riferimento alla nostra assistenza alla
            pagina
            <br />https://www.pienissimo.com/assistenza dove, se necessario,
            contattare il nostro staff in Live Chat. In alternativa puoi
            contattare il tuo Tutor di riferimento.
          </div>
        </div>

        <div class="ticket-bottom-title" style="left: 315pt">
          MESSAGGIO DALL'ORGANIZZATORE
        </div>
        <div class="ticket-info-box ticket-organizer">
          <p>
            <b>Il biglietto è nominativo e personale.</b><br />Non puoi cederlo
            a terzi.
          </p>
          <p>
            Quindi,
            <b>per accedere a <apex:outputText value="{!eventName}" /></b
            ><br />dovrai presentarti al check-in con:
          </p>
          <ul>
            <li>il <b>presente biglietto</b> stampato;</li>
            <li>
              i <b>Documenti di Iscrizione al corso</b> che sono 7 pagine da
              consegnare al personale al check-in;
            </li>
            <li>
              un <b>Documento d'Identità</b> valido per l'identificazione del
              partecipante;
            </li>
          </ul>
          <p>
            Inoltre, qui trovi ricapitolate alcune informazioni che possono
            esserti utili:
          </p>
          <table class="ticket-organizer-table">
            <tr>
              <td class="k">Orario Inizio Check-In:</td>
              <td class="v"><apex:outputText value="{!checkInTime}" /></td>
            </tr>
            <tr>
              <td class="k">Luogo dell'evento:</td>
              <td class="v">
                <apex:outputText value="{!eventLocationLine}" />
              </td>
            </tr>
            <tr>
              <td class="k">Parcheggio:</td>
              <td class="v"><apex:outputText value="{!parking}" /></td>
            </tr>
          </table>
        </div>
      </div>

