<aura:component
  implements="lightning:homeTemplate"
  access="global"
  description="Home vendite con dashboard, sincronizzazione Mexal e attività quotidiane."
>
  <aura:attribute name="opportunitiesSummary" type="Aura.Component[]" />
  <aura:attribute name="activitySummary" type="Aura.Component[]" />
  <aura:attribute name="leadsSummary" type="Aura.Component[]" />
  <aura:attribute name="top" type="Aura.Component[]" />
  <aura:attribute name="dashboardSummary" type="Aura.Component[]" />
  <aura:attribute name="opportunityDashboard" type="Aura.Component[]" />
  <aura:attribute name="orderDashboard" type="Aura.Component[]" />
  <aura:attribute name="trancheDashboard" type="Aura.Component[]" />
  <aura:attribute name="invoiceDashboard" type="Aura.Component[]" />
  <aura:attribute name="left" type="Aura.Component[]" />
  <aura:attribute name="middle" type="Aura.Component[]" />
  <aura:attribute name="right" type="Aura.Component[]" />

  <div class="sales-home" role="main">
    <div class="welcome">
      <h1>Home vendite</h1>
      <p>
        Opportunità, relazioni e attività: la tua giornata a colpo d'occhio.
      </p>
    </div>

    <div class="sync-region">{!v.top}</div>
    <div class="dashboard-grid">
      <div class="dashboard-region">{!v.dashboardSummary}</div>
      <div class="dashboard-region">{!v.opportunityDashboard}</div>
    </div>
    <div class="dashboard-region">{!v.orderDashboard}</div>
    <div class="dashboard-region">{!v.trancheDashboard}</div>
    <div class="dashboard-region">{!v.invoiceDashboard}</div>

    <div class="work-grid">
      <div
        role="region"
        class="home-card work-card"
        aria-label="Attività di oggi"
      >
        <div class="card-heading">
          <span class="eyebrow">OGGI</span>
          <h2>Le attività di oggi</h2>
        </div>
        <div class="region-body">{!v.left}</div>
      </div>
      <div role="region" class="home-card work-card" aria-label="Eventi">
        <div class="card-heading">
          <span class="eyebrow">AGENDA</span>
          <h2>I prossimi eventi</h2>
        </div>
        <div class="region-body">{!v.middle}</div>
      </div>
    </div>
  </div>
</aura:component>
