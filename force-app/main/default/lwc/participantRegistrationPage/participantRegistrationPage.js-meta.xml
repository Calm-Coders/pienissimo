<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Participant Registration Page</masterLabel>
    <description
  >Collects participants for unassigned ticket Assets.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property
        name="heading"
        type="String"
        label="Page heading"
        default="Registrazione partecipanti"
      />
            <property
        name="servicePath"
        type="String"
        label="Deprecated API path"
        default=""
        description="Kept only for existing Experience Builder page compatibility. The component now calls Apex methods directly."
      />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
