<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Quote Acceptance Page</masterLabel>
    <description
  >Shows a Quote on an Experience Cloud page and accepts or rejects it.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property
        name="heading"
        type="String"
        label="Page heading"
        default="Gestione preventivo"
      />
            <property
        name="servicePath"
        type="String"
        label="Deprecated API path"
        default=""
        description="Kept only for existing Experience Builder page compatibility. The component now calls Apex methods directly."
      />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
